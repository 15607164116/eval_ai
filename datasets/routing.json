[
  {
    "description": "路由测试-查平台规则应调RAG",
    "vars": {
      "query": "二手平台买到假货，退款流程是什么？"
    },
    "assert": [
      {
        "type": "javascript",
        "value": "return output.includes('rag_summarize');"
      }
    ]
  },
  {
    "description": "路由测试-查天气应先定位再调天气",
    "vars": {
      "query": "我明天去二手市场面交，天气怎么样？"
    },
    "assert": [
      {
        "type": "javascript",
        "value": "return output.includes('get_user_location') && output.includes('get_weather');"
      }
    ]
  },
  {
    "description": "路由测试-闲聊不应调用任何工具",
    "vars": {
      "query": "你好呀，你是谁？"
    },
    "assert": [
      {
        "type": "javascript",
        "value": "return !output.includes('rag_summarize') && !output.includes('get_weather') && !output.includes('fetch_external_data');"
      }
    ]
  }
]